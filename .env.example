PORT=3000

# KIRAPAY
# Get this from https://dashboard.kira-pay.com after onboarding.
KIRAPAY_API_KEY=

# Latest public docs list https://api.kira-pay.com/api as the base URL.
# If the beta dashboard gives you a different endpoint, override it here.
KIRAPAY_API_BASE=https://api.kira-pay.com/api

# Receiver/settlement is controlled by your KIRAPAY merchant setup.
# Use the address configured in your KIRAPAY dashboard.
KIRAPAY_RECEIVER=7n5FZ7yMS6tZ7DemoSolanaSettlementWallet111111
KIRAPAY_SETTLEMENT_CHAIN=Solana
KIRAPAY_SETTLEMENT_TOKEN=USDC

# Force demo mode even when an API key exists.
KIRAPAY_MOCK=0
